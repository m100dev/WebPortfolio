# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
# every env file Vite loads (.env, .env.local, .env.[mode], .env.[mode].local)
.env
.env.*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# claude code (personal settings)
.claude/settings.local.json

# graphify: commit only graph.json and GRAPH_REPORT.md. The rest is cache, hook state,
# or (.graphify_root) the absolute local path of the repo.
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
