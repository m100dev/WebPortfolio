{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/precommit/claude-hook.js\"",
            "timeout": 300,
            "statusMessage": "Checking git commit against the pre-commit hook"
          }
        ]
      }
    ]
  }
}
